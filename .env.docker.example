# Copy this file to .env.docker on your server and adjust the values.

POSTGRES_DB=skedra
POSTGRES_USER=skedra
POSTGRES_PASSWORD=change-this-database-password

# PostgreSQL pool and server-side query guards (per API instance).
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_MAX_LIFETIME_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# Keep the default Docker named volume locally. On TrueNAS, prefer a dataset path,
# for example: /mnt/tank/apps/skedra/postgres
SKEDRA_POSTGRES_DATA=skedra_postgres_data

# Public URLs as seen by the browser. If you put Skedra behind a reverse proxy,
# use your real https URLs here.
SKEDRA_PUBLIC_APP_URL=http://localhost:5174
SKEDRA_PUBLIC_LIBRARIES_URL=http://localhost:5175
SKEDRA_PUBLIC_API_URL=http://localhost:5174
# Bleibt im API-Container auf Loopback; niemals auf Public-/VPN-URL setzen.
SKEDRA_MCP_INTERNAL_API_URL=http://127.0.0.1:3001/api/v1

# open = anyone can register, invite = first user plus invite links, closed = first user only.
SKEDRA_DEPLOYMENT_MODE=selfhost
SKEDRA_REGISTRATION_MODE=invite

# Local catalog by default. Configure a remote URL only for an operator you choose.
SKEDRA_LIBRARY_CATALOG_MODE=local
SKEDRA_LIBRARY_CATALOG_API_URL=
SKEDRA_LIBRARY_SUBMIT_URL=
SKEDRA_REQUIRE_EMAIL_VERIFICATION=false

# Usually leave this empty. Set it only if your API is on a different public origin.
SKEDRA_PUBLIC_FRONTEND_API_URL=

# Optional calls via LiveKit. These values are the server fallback; admins can
# also configure calls in Settings -> System inside the app. Use LiveKit Cloud,
# your own LiveKit deployment, or docker-compose.livekit.yml for local testing.
SKEDRA_CALLS_ENABLED=false
SKEDRA_CALL_PROVIDER=none
SKEDRA_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=3600

# New uploads use a persistent server folder. Use s3 for S3-compatible storage
# or inline for the legacy PostgreSQL mode.
SKEDRA_OBJECT_STORAGE_PROVIDER=filesystem
# Docker volume or absolute host path, e.g. /mnt/tank/apps/skedra/assets.
# Compose mounts this at /data/assets and sets SKEDRA_OBJECT_STORAGE_PATH there.
SKEDRA_ASSET_DATA=skedra_asset_data
SKEDRA_OBJECT_STORAGE_PRESET=custom
SKEDRA_OBJECT_STORAGE_ENDPOINT=
SKEDRA_OBJECT_STORAGE_REGION=
SKEDRA_OBJECT_STORAGE_BUCKET=
SKEDRA_OBJECT_STORAGE_ACCESS_KEY_ID=
SKEDRA_OBJECT_STORAGE_SECRET_ACCESS_KEY=
SKEDRA_OBJECT_STORAGE_PUBLIC_BASE_URL=
SKEDRA_OBJECT_STORAGE_FORCE_PATH_STYLE=false
SKEDRA_ASSET_MAX_IMAGE_BYTES=8388608

# Host ports exposed by docker compose.
SKEDRA_WEB_PORT=5174
SKEDRA_LIBRARIES_PORT=5175

# Generate real secrets for production, for example:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SKEDRA_AUTH_SECRET=change-me-to-a-random-secret-min-32-chars
SKEDRA_DATA_ENCRYPTION_SECRET=change-me-to-a-long-random-secret-min-32-chars
